{
  "name": "@caracal-lynx/sluice",
  "version": "0.4.0",
  "description": "Config-driven ETL toolkit for ERP data migrations",
  "license": "Elastic-2.0",
  "author": "Caracal Lynx Limited <sluice@caracallynx.com> (https://caracallynx.com)",
  "homepage": "https://github.com/caracal-lynx/sluice#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/caracal-lynx/sluice.git"
  },
  "bugs": {
    "url": "https://github.com/caracal-lynx/sluice/issues"
  },
  "keywords": [
    "etl",
    "data-migration",
    "erp",
    "yaml",
    "duckdb",
    "cli",
    "data-quality",
    "pipeline",
    "typescript"
  ],
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "sluice": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "docs/licensing-faq.md",
    "CLAUDE.md",
    "PLUGINS.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch src/cli.ts",
    "lint": "eslint src tests",
    "format": "prettier --write src tests",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "typecheck:tsgo": "tsgo --noEmit",
    "sluice": "tsx src/cli.ts",
    "changeset": "changeset",
    "version": "changeset version && npm install --package-lock-only",
    "release": "npm run build && changeset publish"
  },
  "dependencies": {
    "@duckdb/node-api": "^1.5.0-r.1",
    "axios": "^1.16.1",
    "axios-retry": "^4.5.0",
    "cli-progress": "^3.12.0",
    "commander": "^14.0.3",
    "csv-parse": "^5.6.0",
    "csv-stringify": "^6.5.1",
    "dayjs": "^1.11.20",
    "dotenv": "^17.4.2",
    "expr-eval": "^2.0.2",
    "js-yaml": "^4.1.1",
    "mssql": "^12.5.2",
    "pg": "^8.20.0",
    "picocolors": "^1.1.1",
    "pino": "^10.3.1",
    "xlsx": "^0.18.5",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^0.7.0",
    "@changesets/cli": "^2.31.0",
    "@types/cli-progress": "^3.11.6",
    "@types/js-yaml": "^4.0.9",
    "@types/mssql": "^12.3.0",
    "@types/node": "^24.12.2",
    "@types/pg": "^8.20.0",
    "@typescript/native-preview": "^7.0.0-dev.20260514.1",
    "@vitest/coverage-v8": "^4.1.5",
    "eslint": "^10.3.0",
    "pino-pretty": "^13.0.0",
    "prettier": "^3.8.3",
    "tsx": "^4.19.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.3",
    "vitest": "^4.1.5"
  }
}
