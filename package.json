{
  "name": "@caracal-lynx/sluice",
  "version": "0.1.0",
  "description": "Config-driven ETL toolkit for ERP data migrations",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "sluice": "dist/cli.js"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch src/cli.ts",
    "lint": "eslint src tests",
    "format": "prettier --write src tests",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "sluice": "tsx src/cli.ts"
  },
  "dependencies": {
    "@duckdb/node-api": "^1.5.0-r.1",
    "axios": "^1.7.0",
    "axios-retry": "^4.5.0",
    "cli-progress": "^3.12.0",
    "commander": "^12.1.0",
    "csv-parse": "^5.5.6",
    "csv-stringify": "^6.5.1",
    "dayjs": "^1.11.13",
    "dotenv": "^16.4.5",
    "expr-eval": "^2.0.2",
    "js-yaml": "^4.1.0",
    "mssql": "^11.0.1",
    "pg": "^8.13.0",
    "picocolors": "^1.1.1",
    "pino": "^9.5.0",
    "xlsx": "^0.18.5",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/cli-progress": "^3.11.6",
    "@types/js-yaml": "^4.0.9",
    "@types/mssql": "^9.1.5",
    "@types/node": "^24.12.2",
    "@types/pg": "^8.11.10",
    "@vitest/coverage-v8": "^2.1.0",
    "eslint": "^9.17.0",
    "pino-pretty": "^13.0.0",
    "prettier": "^3.4.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.18.0",
    "vitest": "^2.1.0"
  }
}
