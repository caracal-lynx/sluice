# ── Source — legacy SQL Server (example) ──────────────────────
COCHRAN_MSSQL=mssql://user:password@legacy.example.local/LegacyDB

# ── Target — IFS ERP (file-based bulk import) ─────────────────
IFS_IMPORT_PATH=C:\IFS\Import

# ── Target — Business Central REST (OData v2.0) ───────────────
BC_BASE_URL=https://api.businesscentral.dynamics.com/v2.0
BC_TENANT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
BC_CLIENT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
BC_CLIENT_SECRET=your-client-secret
BC_COMPANY=Example Company Ltd

# ── Source — second legacy SQL Server (example) ───────────────
ERIBE_MSSQL=mssql://user:password@legacy2.example.local/LegacyDB

# ── Target — BlueCherry ERP (file-based bulk import) ──────────
ERIBE_BC_IMPORT_PATH=C:\BlueCherry\Import

# ── Runtime ───────────────────────────────────────────────────
NODE_ENV=development
LOG_LEVEL=info
